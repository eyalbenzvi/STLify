# --- Cloud image→3D (Milestone B) -------------------------------------------
# The generative image→3D mode ("מודל מלא (AI, ענן)") is OFF until a provider
# API key is configured here. Without it the mode appears disabled in the
# import dialog with an explanation — nothing crashes.
#
# The key is read ONLY on the server (app/api/image-to-3d/*). It has no
# NEXT_PUBLIC_ prefix on purpose: it must never reach the client bundle.
#
# Notes on the proxy: rate limiting and the task-id map are in-memory and
# per-instance — suitable for the single-instance workshop deployments this
# app targets, not for a load-balanced fleet.
IMAGE_TO_3D_API_KEY=

# Which provider the key belongs to. Supported: "meshy" (default).
# Meshy was chosen because a finished task exposes an OBJ directly, which
# enters through the existing hardened OBJ importer (docs/AI-IMAGE-PLAN.md §4.1).
IMAGE_TO_3D_PROVIDER=meshy

# --- On-device AI models (Milestone A) ---------------------------------------
# Optional. When set, BOTH model files load from this base URL instead of
# their public defaults (self-hosting):
#   <base>/u2netp.onnx                    (segmentation, 4.6MB, Apache-2.0)
#   <base>/depth_anything_v2_vits.onnx    (depth, 99.4MB, Apache-2.0)
# Defaults are documented in lib/ai/models.ts. Weights are downloaded by the
# BROWSER at first use and cached client-side; they are never bundled.
#NEXT_PUBLIC_AI_MODEL_BASE_URL=
